ALLOWED_CHANNEL_IDS = []

async def gemini_chat_async(contents_payload):
    def _call_gemini():
        response = genai_client.models.generate_content(
            model='models/gemini-3.1-flash-lite',
            contents=contents_payload,
            config=types.GenerateContentConfig(
                system_instruction=system_instruction_text,
                temperature=0.7,
            )
        )
        return response.text
    import asyncio
    return await asyncio.to_thread(_call_gemini)

intents = discord.Intents.default()
intents.message_content = True
intents.members = True

client = discord.Client(intents=intents)
chat_histories = {}

@client.event
async def on_ready():
    print(f"==================================================")
    print(f"Bot Discord (Beban AI Friendly) Online: {client.user}")
    print(f"==================================================")

@client.event
async def on_message(message):
    if message.author == client.user:
        return

    channel_id = message.channel.id

    is_dm = isinstance(message.channel, discord.DMChannel)
    if ALLOWED_CHANNEL_IDS and not is_dm:
        if channel_id not in ALLOWED_CHANNEL_IDS:
            return

    is_mentioned = client.user in message.mentions

    if is_mentioned or is_dm:
        if channel_id not in chat_histories:
            chat_histories[channel_id] = []

        raw_input = message.content.replace(f'<@{client.user.id}>', '').strip()
        if not raw_input:
            raw_input = "halo"

        print(f"[LOG] Pesan masuk dari {message.author.name}: {raw_input}")

        # === Cek kata kunci WOS & panggil DB ===
        msg_lower = raw_input.lower()
        wos_context = ""

        if "bear" in msg_lower:
            # Mengambil data bear (sesuaikan nama tabel jika beda)
            res = query_wos_db("beartime.sqlite", "SELECT * FROM beartime LIMIT 5;")
            if res:
                wos_context = f"\n\n[SISTEM DATA BEAR WOS]: {res}"
        elif "code" in msg_lower or "kode" in msg_lower or "giftcode" in msg_lower:
            # Mengambil data giftcode dari tabel gift_codes
            res = query_wos_db("giftcode.sqlite", "SELECT * FROM gift_codes LIMIT 5;")
            if res:
                wos_context = f"\n\n[SISTEM DATA GIFTCODE WOS]: Berikut list data giftcode asli dari database: {res}. Gunakan data ini untuk menjawab pertanyaan user!"

        # Gabungkan pesan asli user dengan data DB WOS
        user_input = raw_input + wos_context

        if message.guild:
            human_members = [m.display_name for m in message.guild.members if not m.bot]
            sample_members = ", ".join(human_members[:30])
            info_str = f"[INFO SERVER: Total {len(human_members)} member manusia, antara lain: {sample_members}]\n"
        else:
            info_str = "[INFO: Percakapan via DM]\n"

        sender_name = message.author.display_name
        formatted_input = f"{info_str}[{sender_name}]: {user_input}"

        user_turn = {'role': 'user', 'parts': [{'text': formatted_input}]}
        chat_histories[channel_id].append(user_turn)

        if len(chat_histories[channel_id]) > 10:
            chat_histories[channel_id] = chat_histories[channel_id][-10:]

        async with message.channel.typing():
            try:
                bot_reply = await gemini_chat_async(chat_histories[channel_id])

                if not bot_reply or not bot_reply.strip():
                    bot_reply = "Halo! Ada yang mau dibahas atau ditanyain?"

                model_turn = {'role': 'model', 'parts': [{'text': bot_reply}]}
                chat_histories[channel_id].append(model_turn)

                await message.channel.send(bot_reply)
                print("[LOG] Berhasil membalas via Gemini!")

            except Exception as e:
                print(f"[ERROR Gemini] {e}")
                if chat_histories[channel_id]:
                    chat_histories[channel_id].pop()
                await message.channel.send("Eh maaf, lagi ada sedikit kendala koneksi nih. Coba tanya lagi ya!")

