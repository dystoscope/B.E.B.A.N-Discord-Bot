async def gemini_chat_async(contents_payload):
    config = types.GenerateContentConfig(
        system_instruction=system_instruction_text,
        temperature=0.2
    )
    
    def _call_api():
        response = genai_client.models.generate_content(
            model='gemini-3.1-flash-lite',
            contents=contents_payload,
            config=config
        )
        return response.text

    loop = asyncio.get_running_loop()
    return await loop.run_in_executor(None, _call_api)

import requests

def search_web_image(query):
    """Mencari gambar di web dan mengunduhnya ke file lokal agar tidak terhadang hotlink/error Wikimedia"""
    try:
        headers = {
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        }
        with DDGS(headers=headers) as ddgs:
            results = list(ddgs.images(query, max_results=5))
            
            for item in results:
                img_url = item.get('image')
                if "upload.wikimedia.org" in img_url and "px-" in img_url:
                    continue
                
                try:
                    resp = requests.get(img_url, headers=headers, timeout=5)
                    if resp.status_code == 200 and len(resp.content) > 1000:
                        temp_path = "temp_search.jpg"
                        with open(temp_path, "wb") as f:
                            f.write(resp.content)
                        return temp_path
                except Exception:
                    continue
    except Exception as e:
        print(f"[ERROR DDG IMAGE SEARCH]: {e}")
    return None

